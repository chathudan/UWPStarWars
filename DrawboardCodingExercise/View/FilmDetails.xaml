<Page
	x:Class="DrawboardCodingExercise.View.FilmDetails"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:valueConverters="using:DrawboardCodingExercise.ValueConverters"
	mc:Ignorable="d"
	Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

	<Page.Resources>
		<valueConverters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
	</Page.Resources>

	<Grid Margin="16">
		<ProgressRing IsActive="{Binding IsLoading}"
		              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
		              HorizontalAlignment="Left" VerticalAlignment="Top"
		              Width="32" Height="32" />

		<TextBlock x:Uid="FilmDetails.InvalidSelection"
		           d:Text="This film could not be opened. Please go back and select another film."
		           Visibility="{Binding IsInvalidSelection, Converter={StaticResource BoolToVisibilityConverter}}"
		           TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Top" />

		<TextBlock x:Uid="FilmDetails.Error"
		           d:Text="We couldn't load this film."
		           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
		           HorizontalAlignment="Left" VerticalAlignment="Top" />

		<ScrollViewer Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVisibilityConverter}}"
		              VerticalScrollBarVisibility="Auto">
			<StackPanel DataContext="{Binding Film}" MaxWidth="720" HorizontalAlignment="Left">
				<TextBlock Text="{Binding Title}" Style="{StaticResource SubtitleTextBlockStyle}" />
				<TextBlock Text="{Binding EpisodeLabel}" Opacity="0.7" Margin="0,0,0,12" />

				<TextBlock x:Uid="FilmDetails.ReleaseDate" d:Text="Release Date" FontWeight="SemiBold" />
				<TextBlock Text="{Binding ReleaseDateDisplay}" Margin="0,0,0,12" />

				<TextBlock x:Uid="FilmDetails.Director" d:Text="Director" FontWeight="SemiBold" />
				<TextBlock Text="{Binding Director}" Margin="0,0,0,12" />

				<TextBlock x:Uid="FilmDetails.Producer" d:Text="Producer" FontWeight="SemiBold" />
				<TextBlock Text="{Binding Producer}" Margin="0,0,0,12" />

				<TextBlock x:Uid="FilmDetails.OpeningCrawl" d:Text="Opening Crawl" FontWeight="SemiBold" />
				<TextBlock Text="{Binding OpeningCrawl}" TextWrapping="Wrap" Margin="0,0,0,12" />
			</StackPanel>
		</ScrollViewer>
	</Grid>
</Page>
