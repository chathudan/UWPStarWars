<Page
	x:Class="DrawboardCodingExercise.View.FilmDetails"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:valueConverters="using:DrawboardCodingExercise.ValueConverters"
	mc:Ignorable="d"
	Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

	<Page.Resources>
		<valueConverters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
	</Page.Resources>

	<Grid Margin="16">
		<ProgressRing IsActive="{Binding IsLoading}"
		              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
		              HorizontalAlignment="Left" VerticalAlignment="Top"
		              Width="32" Height="32" />

		<TextBlock Text="{Binding InvalidSelectionMessage}"
		           Visibility="{Binding IsInvalidSelection, Converter={StaticResource BoolToVisibilityConverter}}"
		           TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Top" />

		<TextBlock Text="{Binding ErrorMessage}"
		           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
		           HorizontalAlignment="Left" VerticalAlignment="Top" />

		<ScrollViewer Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVisibilityConverter}}"
		              VerticalScrollBarVisibility="Auto">
			<!-- DataContext deliberately left as the page ViewModel (not rebound to Film) so the
			     label TextBlocks below can bind directly to the ViewModel's localized *Label
			     properties; each data field is instead prefixed with "Film." -->
			<StackPanel MaxWidth="720" HorizontalAlignment="Left">
				<TextBlock Text="{Binding Film.Title}" Style="{StaticResource SubtitleTextBlockStyle}" />
				<TextBlock Text="{Binding Film.EpisodeLabel}" Opacity="0.7" Margin="0,0,0,12" />

				<TextBlock Text="{Binding ReleaseDateLabel}" FontWeight="SemiBold" />
				<TextBlock Text="{Binding Film.ReleaseDateDisplay}" Margin="0,0,0,12" />

				<TextBlock Text="{Binding DirectorLabel}" FontWeight="SemiBold" />
				<TextBlock Text="{Binding Film.Director}" Margin="0,0,0,12" />

				<TextBlock Text="{Binding ProducerLabel}" FontWeight="SemiBold" />
				<TextBlock Text="{Binding Film.Producer}" Margin="0,0,0,12" />

				<TextBlock Text="{Binding OpeningCrawlLabel}" FontWeight="SemiBold" />
				<TextBlock Text="{Binding Film.OpeningCrawl}" TextWrapping="Wrap" Margin="0,0,0,12" />

				<!-- Character section: its own independent loading/empty/error/partial states,
				     so a character failure never blanks the film's details above. -->
				<TextBlock Text="{Binding CharactersLabel}" FontWeight="SemiBold" Margin="0,12,0,4" />

				<ProgressRing IsActive="{Binding IsCharactersLoading}"
				              Visibility="{Binding IsCharactersLoading, Converter={StaticResource BoolToVisibilityConverter}}"
				              HorizontalAlignment="Left" Width="20" Height="20" Margin="0,0,0,8" />

				<TextBlock Text="{Binding CharactersEmptyMessage}"
				           Visibility="{Binding IsCharactersEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
				           TextWrapping="Wrap" Margin="0,0,0,8" />

				<TextBlock Text="{Binding CharactersErrorMessage}"
				           Visibility="{Binding HasCharactersError, Converter={StaticResource BoolToVisibilityConverter}}"
				           TextWrapping="Wrap" Margin="0,0,0,8" />

				<TextBlock Text="{Binding CharactersPartialMessage}"
				           Visibility="{Binding HasPartialCharacterFailure, Converter={StaticResource BoolToVisibilityConverter}}"
				           TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8" />

				<ItemsControl ItemsSource="{Binding Characters}"
				              Visibility="{Binding IsCharactersLoaded, Converter={StaticResource BoolToVisibilityConverter}}"
				              Margin="0,0,0,12">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding Name}" Margin="0,2" />
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</Page>
